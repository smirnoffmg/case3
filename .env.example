# LLM provider: ollama | openai | anthropic (optional — auto-detected from keys/URLs)
# LLM_PROVIDER=ollama

# --- Ollama (local, OpenAI-compatible) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=qwen2.5:7b

# --- OpenAI Cloud (uncomment and set LLM_PROVIDER=openai) ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=

# --- Claude / Anthropic (uncomment and set LLM_PROVIDER=anthropic) ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

LLM_TEMPERATURE=0.0

# Pipeline
MAX_ITERATIONS=5
TIMEOUT_SEC=60
RETRIEVER_TOP_K=8

# Judge approval thresholds
RISK_THRESHOLD=4.0
HARD_BLOCK_RISK=8.0

# Eval DB (optional — when set, eval executes pred + gold and compares result
# sets instead of AST-matching. Spin up via `docker compose up -d` + `make seed`.)
# EVAL_DATABASE_URL=postgresql://case3:case3@localhost:55432/demo_db

# Streamlit (optional)
STREAMLIT_PAGE_TITLE=SQL Security System
STREAMLIT_LAYOUT=wide
