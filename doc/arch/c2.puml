@startuml C2_Container
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title C4 Level 2: Containers

Person(analyst, "Аналитик / Разработчик")
System_Ext(llm, "LLM API", "Генерация + семантический аудит")

System_Boundary(sqlsec, "SQL Security System") {
    Container(ui, "Интерфейс", "Python / Streamlit", "Ввод задачи, отображение финального SQL и пошагового лога аудита")
    Container(core, "Пайплайн генерации и аудита", "Python 3.12+", "Оркестрирует цикл генератор -> судья -> исправление; накапливает обратную связь; следит за лимитами и таймаутом 60с")
    Container(schema_svc, "Сервис схемы", "Python", "Парсит data_model.sql в schema.json; RAG-выборка релевантных таблиц; каталог чувствительных полей")
    ContainerDb(stores, "Хранилище артефактов", "JSON / файлы", "schema.json, few-shot примеры, авторский датасет (NL -> SQL), логи прогонов")
    Container(eval, "Стенд оценки качества", "Python", "Прогон пайплайна по размеченному датасету; Execution Accuracy, precision/recall судьи, статистика по итерациям; выход — отчёт с метриками")
}

Rel(analyst, ui, "Описывает задачу; читает результат", "HTTP")
Rel(ui, core, "run_sql_security_pipeline(task)")
Rel(core, schema_svc, "Запрашивает релевантный контекст схемы")
Rel(core, llm, "Промпты генерации и аудита", "HTTPS / JSON")
Rel(schema_svc, stores, "Читает schema.json, few-shot")
Rel(core, stores, "Пишет лог прогона")
Rel(eval, core, "Прогоняет на датасете")
Rel(eval, stores, "Читает датасет, пишет метрики")

@enduml